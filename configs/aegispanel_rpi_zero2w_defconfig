# AegisPanel OS Buildroot Defconfig for Raspberry Pi Zero 2 W (aarch64)

BR2_aarch64=y
BR2_cortex_a53=y
BR2_ARM_FPU_VFPV4=y

# Linux Kernel (mainline LTS – default arm64 kernel defconfig covers BCM2837 / RPi Zero 2 W)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_LTS_VERSION=y
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2837-rpi-zero-2-w"

# Init / Service System
BR2_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD=y

# Toolchain Requirements for WPE WebKit & C++
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_INSTALL_LIBSTDCPP=y
BR2_USE_WCHAR=y
BR2_TOOLCHAIN_HAS_THREADS=y
BR2_TOOLCHAIN_HAS_THREADS_NPTL=y
BR2_ENABLE_LOCALE=y

# Graphics, Wayland, Mesa 3D & EGL/GLES
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_V3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VC4=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GBM=y

# WPE WebKit & Cog Kiosk Stack
BR2_PACKAGE_LIBWPE=y
BR2_PACKAGE_WPEBACKEND_FDO=y
BR2_PACKAGE_WPEWEBKIT=y
BR2_PACKAGE_COG=y
BR2_PACKAGE_COG_PLATFORM_FDO=y
BR2_PACKAGE_COG_PLATFORM_DRM=y

# System Libraries & Camera Support
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBV4L=y
BR2_PACKAGE_LIBV4L_UTILS=y

# AegisPanel OS Packages
BR2_PACKAGE_HOST_RUSTC=y
BR2_PACKAGE_AEGISPANEL_CORE=y
BR2_PACKAGE_AEGISPANEL_UI=y
BR2_PACKAGE_AEGISPANEL_UPDATER=y

# Root FS Image Format
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="2500M"

# Root FS Overlay
BR2_ROOTFS_OVERLAY="/home/oliver/dev/panel/board/raspberrypi/zero2w/overlays/aegispanel-overlay"
